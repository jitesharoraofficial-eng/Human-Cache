# Human Cache - Environment Configuration Template
# Duplicate this file to .env and supply actual secrets. Do NOT commit .env.

# Server Configuration
PROJECT_NAME="Human Cache"
API_V1_STR="/api/v1"

# Database & Storage
DATABASE_URL="sqlite:///./human_cache.db"
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=25

# Authentication & Security
SECRET_KEY="replace-with-a-strong-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SESSION_COOKIE_NAME="humancache_session"
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"

# AI Provider Configuration (Backend Only)
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
LLM_PROVIDER="gemini"
